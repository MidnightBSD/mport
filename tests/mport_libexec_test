setup_merge_tree()
{
	mkdir -p croot/tmp croot/var/db/mport stage/usr/local
}

# make_merge_pkg name file [mport.create args...]: build croot/<name>.mport
# from stage/; with an empty file, plist.<name> must already exist.
make_merge_pkg()
{
	name=$1
	file=$2
	shift 2
	if [ -n "${file}" ]; then
		printf '%s\n' "${file}" >"plist.${name}"
	fi
	while read -r line; do
		path=${line#@(*) }
		mkdir -p "stage/usr/local/$(dirname "${path}")"
		printf '%s\n' "${name}" >"stage/usr/local/${path}"
	done <"plist.${name}"
	atf_check -s exit:0 -o ignore -e ignore \
		"${MPORT_CREATE}" -n "${name}" -v 1.0 -l en -o "${PWD}/croot/${name}.mport" \
		-s "${PWD}/stage" -p "${PWD}/plist.${name}" -P /usr/local \
		-O "misc/${name}" -t misc -c "${name}" "$@"
}

setup_fake_tree()
{
	mkdir -p root/usr/local/share/testpkg
	printf "hello\n" >root/usr/local/share/testpkg/file.txt
	printf "share/testpkg/file.txt\n" >plist
}

